{
  "name": "governmindz",
  "private": true,
  "version": "0.1.0",
  "description": "GOVERNMINDZ — role-based multi-agent debate with Zetaris Lightning and Meterless Runtime integrations.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prestart": "npm run build",
    "start": "node scripts/setup.mjs && node --env-file=.env.local --import tsx apps/web/server.ts",
    "preweb": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "test:sample": "node --import tsx tests/run_debate_sample.test.ts",
    "test:e2e": "playwright test",
    "test": "node scripts/run-tests.mjs",
    "demo": "node --env-file=.env.local --import tsx apps/gateway/src/main.ts",
    "demo:dry": "node --env-file=.env.local --import tsx apps/gateway/src/main.ts --dry-run",
    "demo:sample": "node --import tsx apps/gateway/src/sample.ts",
    "zetaris:check": "node --env-file=.env.local --import tsx scripts/check-zetaris.ts",
    "samples": "node scripts/run-samples.mjs",
    "smoke": "node --env-file=.env.local --import tsx apps/gateway/src/smoke.ts",
    "orchestrator": "node --env-file=.env.local --import tsx apps/gateway/src/main.ts --orchestrator",
    "web": "node --env-file=.env.local --import tsx apps/web/server.ts",
    "mcp": "node --env-file=.env.local --import tsx apps/gateway/src/mcp-server.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@elevenlabs/react": "^1.20.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
