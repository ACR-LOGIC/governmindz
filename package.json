{
	"name": "governmindz",
	"private": true,
	"version": "0.1.0",
	"description": "GOVERNMINDZ — role-based multi-agent debate with Zetaris Lightning and Meterless Runtime integrations.",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "vite build",
		"dev": "vite",
		"test:e2e": "playwright test",
		"test": "node scripts/run-tests.mjs",
		"demo": "node --env-file=.env.local --import tsx apps/gateway/src/main.ts",
		"demo:dry": "node --env-file=.env.local --import tsx apps/gateway/src/main.ts --dry-run",
		"demo:sample": "node --import tsx apps/gateway/src/sample.ts",
		"samples": "node scripts/run-samples.mjs",
		"smoke": "node --env-file=.env.local --import tsx apps/gateway/src/smoke.ts",
		"orchestrator": "node --env-file=.env.local --import tsx apps/gateway/src/main.ts --orchestrator",
		"web": "node --env-file=.env.local --import tsx apps/web/server.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.31",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
