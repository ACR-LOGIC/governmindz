{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"composite": true,
		"declaration": true,
		"isolatedDeclarations": false,
		"noEmit": true
	},
	"include": ["src/**/*"],
	"exclude": ["src/coverage/**/*"]
}
