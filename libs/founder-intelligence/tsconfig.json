{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"noEmit": true,
		"composite": true,
		"declaration": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": ["src/**/*"]
}
