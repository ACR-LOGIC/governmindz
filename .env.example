# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Audit trail signing. Required before importing libs/core.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_TRAIL_SECRET=

# Optional: 32-byte base64 key for Gravity receipt signing.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_MASTER_KEY=

# Meterless Runtime (OpenAI-compatible local runtime).
# Get the token from the runtime's /connect link; never paste it into source or logs.
# Cloud provider keys (OpenAI, Anthropic, Google, NVIDIA, OpenRouter) belong in the
# Meterless Nightshift app, not here. Nightshift exposes the enabled models through
# /v1/models; GovernMindz discovers them dynamically.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=
METERLESS_RUNTIME_TOKEN=
# Optional: paste the full /connect link here instead of the base URL and token.
# The link contains the token; keep this file gitignored and never share it.
METERLESS_CONNECT_LINK=
# Optional: directory containing the runtime's proxy-token file.
# Defaults to %LOCALAPPDATA%\Meterless on Windows.
METERLESS_STATE_DIR=
METERLESS_APP_ID=governmindz
METERLESS_TIMEOUT_MS=180000
METERLESS_MAX_RETRIES=2
METERLESS_RETRY_BASE_MS=500
# Preferred model/lane id. Set this to the lane exposed by your runtime.
METERLESS_MODEL=meterless/auto
# Legacy fallback used when METERLESS_MODEL is empty.
NEMOTRON_MODEL=meterless/auto
# Optional faster model/lane for debate seats; defaults to METERLESS_MODEL.
METERLESS_SEAT_MODEL=meterless/fast

# Zetaris Lightning REST / Federated SQL Credentials
ZETARIS_HOST=
ZETARIS_PORT=443
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_DATABASE=LIGHTNING_DB
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_API_AUTH=
ZETARIS_DEMO_QUERY=SHOW LIGHTNING DATABASES

# JDBC is not wired into this demo; kept for the Zetaris onboarding scripts.
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Optional topic override for the demo debate.
GOVERNMINDZ_TOPIC=

# Sample mode needs no Zetaris or Meterless credentials. Run it with:
#   npm run demo:sample
# It uses input_examples/01-fragmented-intelligence.json, writes a generated
# output to output_examples/, and writes a JSONL trace to logs/.
# The variables below are optional overrides; leave them commented for live mode.
# SAMPLE_MODE=true
# SAMPLE_SCENARIO=input_examples/01-fragmented-intelligence.json
# SAMPLE_OUTPUT=output_examples/01-fragmented-intelligence.json
# SAMPLE_LOG=logs/01-fragmented-intelligence.jsonl

# Optional: write a JSONL trace for a live demo run.
# GOVERNMINDZ_LOG_PATH=logs/live-demo.jsonl
